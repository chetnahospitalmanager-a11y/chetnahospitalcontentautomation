# Copy to .env and fill in. Never commit .env (this repository is public).

# --- Approval page ---
APP_PASSWORD=                 # password staff type to open the approval page
SESSION_SECRET=               # random, at least 32 characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PUBLIC_BASE_URL=              # e.g. https://chetna-social.onrender.com (Instagram/Google fetch images from here)
PORT=3000

# --- Scheduling ---
DRAFT_CRON=0 10 * * 1,3,5     # Mon/Wed/Fri 10:00; leave empty to turn off automatic drafts
TZ_NAME=Asia/Kolkata
MAX_PENDING_DRAFTS=2          # don't write more drafts while this many are waiting
CRON_SECRET=                  # optional: lets an external scheduler POST /cron/draft with header x-cron-secret

# --- Database (local file by default; use Turso on Render because its disk is wiped on redeploy) ---
DATABASE_URL=file:social.db
DATABASE_AUTH_TOKEN=

# --- Gemini (captions) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# --- Booking links added to every post ---
BOOKING_WHATSAPP_NUMBER=      # WhatsApp booking number with country code, e.g. 91XXXXXXXXXX
BOOKING_PHONE_DISPLAY=        # phone number shown on Facebook/Instagram (never sent to Google)

# --- Facebook Page + Instagram ---
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=       # never-expiring Page token (see README)
META_IG_USER_ID=              # Instagram Business account id linked to the Page
META_GRAPH_VERSION=v23.0

# --- Google Business Profiles (after Google approves API access) ---
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=            # written by: npm run gbp:auth
GBP_HOSPITAL_LOCATION=        # optional, e.g. locations/1234567890 if the hospital profile isn't detected

# --- Google review replies (uses the GBP_* sign-in above) ---
REVIEW_CRON=15 8-20/3 * * *   # check for new reviews every 3 hours, 08:15-20:15; empty = off
REVIEW_MAX_AGE_DAYS=60        # ignore reviews older than this (first sync won't pull years of history)
REVIEW_DRAFTS_PER_SYNC=20     # Gemini drafts per check; the rest are drafted next time
REVIEW_CONTACT_LINE=          # optional, e.g. Please call our front desk on 020-XXXXXXXX so we can help.

# --- Weekly insights report (uses the GBP_* sign-in above + Business Profile Performance API) ---
INSIGHTS_CRON=0 9 * * 4        # Thursday 09:00; empty = off
INSIGHTS_LAG_DAYS=3            # report the last Mon-Sun week that ended at least this many days ago

# --- Optional WhatsApp alerts: drafts, new reviews, weekly report (send-only, via WATI) ---
WATI_API_ENDPOINT=
WATI_API_TOKEN=
WATI_TEMPLATE=chetna_social_update
ALERT_PHONES=                 # comma-separated, with country code
